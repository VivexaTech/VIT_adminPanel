# Copy into the admin panel .env.local. Use the same Cloudflare Stream account as the student portal.

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_ALLOWED_ORIGINS=vit.vivexatech.in,vitpanel.vivexatech.in,localhost,127.0.0.1

# Optional alias if the token is stored under this name instead
# CLOUDFLARE_API_TOKEN=
